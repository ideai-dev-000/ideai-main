### IdeaI Root .gitignore
### NOTE: Prefer repo-level ignores only.
### If an app needs a new ignore, add it here with a path prefix
### (e.g., apps/web/.next) rather than creating app-level .gitignore.
### Only use app-level .gitignore if a tool requires it and we cannot
### scope the pattern at the root.

# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store
.pnpm-debug.log*
.npm-debug.log*
.yarn-debug.log*
.yarn-error.log*

# Logs
logs
*.log

# Env (keep examples)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Next.js / build output
.next
out
dist
build
.turbo
.vercel
.cache

# Coverage / test artifacts
coverage
.nyc_output
playwright-report
test-results

# IDE / OS
.DS_Store
.idea
.vscode
*.swp
*.swo

# Misc
*.tgz
*.zip
