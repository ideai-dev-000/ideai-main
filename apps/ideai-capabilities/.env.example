# IdeaI Capabilities - Local Development Environment Variables
# Copy this file to .env.local and fill in your values
# 
# Note: .env.local is gitignored and will never be committed

# ============================================
# Required: Database
# ============================================
# PostgreSQL connection string
# For local development, use a local PostgreSQL instance or a service like Neon
# Example: postgresql://user:password@localhost:5432/workflow_builder
DATABASE_URL=postgresql://user:password@localhost:5432/workflow_builder

# ============================================
# Required: Better Auth
# ============================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# Local development URL (app runs on port 3018)
BETTER_AUTH_URL=http://localhost:3018

# Optional: Public app URL (used if BETTER_AUTH_URL is not set)
NEXT_PUBLIC_APP_URL=http://localhost:3018

# ============================================
# Required: Integration Encryption
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is used to encrypt credentials stored in the database
INTEGRATION_ENCRYPTION_KEY=your-64-character-hex-string-generate-with-node

# ============================================
# Optional: AI Gateway (for AI workflow generation)
# ============================================
# Your OpenAI API key or Vercel AI Gateway API key
# Get from: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=your-openai-api-key

# ============================================
# Optional: Integration Credentials
# These are used when testing workflows with integrations
# You can also configure these in the UI under Settings > Integrations
# ============================================

# Slack Integration
# Get from: https://api.slack.com/apps
SLACK_API_KEY=xoxb-your-slack-bot-token

# Linear Integration
# Get from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_your-linear-api-key
LINEAR_TEAM_ID=your-linear-team-id

# Resend Integration
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Firecrawl Integration
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# ============================================
# Optional: Social Auth Providers
# ============================================
# GitHub OAuth (for Better Auth)
# Get from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth (for Better Auth)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# Optional: Vercel OAuth (for AI Gateway User Keys)
# ============================================
# Get from: https://vercel.com/integrations
VERCEL_CLIENT_ID=your-vercel-client-id
VERCEL_CLIENT_SECRET=your-vercel-client-secret
