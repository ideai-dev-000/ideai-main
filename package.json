{
  "name": "ideai-monorepo",
  "private": true,
  "scripts": {
    "build": "node scripts/ideai-build-sync-submodules.mjs --init --quiet && turbo run build",
    "build:cold": "node scripts/ideai-build-cold-refresh.mjs",
    "build:clean": "node scripts/ideai-build-cold-refresh.mjs --no-build",
    "dev:stop": "node scripts/ideai-develop-graceful-shutdown.mjs",
    "dev:stop:force": "node scripts/ideai-develop-graceful-shutdown.mjs --force",
    "v0:sync": "node scripts/ideai-v0-sync.mjs",
    "v0:sync:preview": "node scripts/ideai-v0-sync.mjs --preview",
    "v0:watch": "node scripts/ideai-v0-sync.mjs --watch",
    "v0:promote": "node scripts/ideai-v0-promote.mjs",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev --concurrency=20",
    "dev:build-check": "node scripts/dev-manager.mjs build-check",
    "dev:restart": "node scripts/dev-manager.mjs restart",
    "dev:start": "node scripts/dev-manager.mjs start",
    "dev:status": "node scripts/dev-manager.mjs status",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "prepare": "husky install",
    "sync-docs": "./scripts/ideai-develop-sync-docs.sh",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": "3.30.0",
    "@edge-runtime/vm": "latest",
    "@emotion/is-prop-valid": "latest",
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@mui/material": "7.3.6",
    "@mui/material-pigment-css": "latest",
    "@next/eslint-plugin-next": "16.1.1",
    "@opentelemetry/api": "latest",
    "@popperjs/core": "latest",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-spring/web": "10.0.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/monitoring": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@tailwindcss/typography": "0.5.19",
    "@unocss/webpack": "latest",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "1.3.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/browser-preview": "latest",
    "@vitest/browser-webdriverio": "latest",
    "@vitest/ui": "latest",
    "bootstrap": "5.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "contentlayer": "0.3.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-only-warn": "1.1.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-turbo": "2.7.2",
    "framer-motion": "12.23.26",
    "globals": "17.0.0",
    "happy-dom": "latest",
    "jiti": "latest",
    "jsdom": "latest",
    "lucide-react": "0.562.0",
    "next": "16.1.1",
    "next-contentlayer": "0.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript-eslint": "8.51.0",
    "unocss": "66.5.12",
    "vite": "latest",
    "vue-router": "latest",
    "zod": "4.3.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@next/bundle-analyzer": "^16.1.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.9",
    "turbo": "^2.7.1",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
